  entries:
  - targetText: {fileID: 1737889906}
    content: Chapter2
  - targetText: {fileID: 911525943}
    content: "\uD0C8\uCD9C\uC740 \uBD84\uBA85 \uC131\uACF5\uC774\uC5C8\uB2E4.\n\n\uCC3D\uACE0
      \uBB38\uC744 \uC5F4\uC5C8\uC744 \uB54C,\n\uBE60\uC838\uB098\uC654\uB2E4\uB294
      \uC0DD\uAC01\uC5D0 \uC7A0\uC2DC \uC548\uB3C4\uD588\uB2E4.\n \n\uD558\uC9C0\uB9CC
      \uACE7 \uC774\uC0C1\uD588\uB2E4. \n\uC5B4\uB450\uCEF4\uCEF4\uD55C \uBCF5\uB3C4\uB294
      \uB098\uB97C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uB2E4. \n\n\uBD84\uBA85
      \uCC98\uC74C\uBCF4\uB294 \uACF3\uC778\uB370, \n\uC774\uC0C1\uD558\uAC8C\uB3C4
      \n\n\uC775\uC219\uD588\uB2E4. \n\n\uADF8\uB9AC\uACE0 \uB098\uB294 \uAE68\uB2EC\uC558\uB2E4.
      \n\uC774\uBC88\uC5D0\uB3C4, \uCD9C\uAD6C\uB294 \uC5C6\uB2E4\uB294 \uAC83\uC744. "
  charsPerSecond: 25
  pauseBetweenEntries: 0.5
  useUnscaledTime: 0
  typeSource: {fileID: 1521171314}
  useLoopSound: 1
