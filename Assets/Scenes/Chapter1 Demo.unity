--- !u!114 &168642626
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 168642624}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35fa8c3d2d61de446a2b24e2c3298240, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  entries:
  - targetText: {fileID: 1725992886}
    content: 'Chapter1 '
  - targetText: {fileID: 1610279424}
    content: "\uB204\uAD70\uAC00\uC758 \uC2B5\uACA9\uC744 \uBC1B\uACE0 \uB208\uC744
      \uB5B4\uC744 \uB550 \uAC07\uD600\uC788\uC5C8\uACE0,\n\uC5EC\uAE30\uC11C \uC5BC\uB9C8\uB098
      \uC2DC\uAC04\uC774 \uC9C0\uB0AC\uB294\uC9C0 \uC54C \uC218 \uC5C6\uC5C8\uB2E4.\n\n\uC77C\uC5B4\uB098\uC790\uB9C8\uC790
      \uBC18\uAE30\uB294 \uAC83\uC740 \uCF54\uB05D\uC744 \uCC0C\uB974\uB294 \uACF0\uD321\uC774
      \uB0C4\uC0C8 \n\uADF8\uB9AC\uACE0 \uAD6C\uC5ED\uC9C8 \uB098\uC624\uB294 \uC1F3\uBB3C
      \uAC19\uC740 \uD53C\uBE44\uB9B0\uB0B4. \n\n\uC774\uB7F0 \uACF3\uC5D0 \uB098\uB97C
      \uBB36\uC9C0 \uC54A\uACE0, \uADF8\uB0E5 \uB358\uC838\uB123\uACE0, \uBB38\uB9CC
      \uC7A0\uAD9C\uB2E4\uB294 \uAC83\u2026\n\uB204\uAD70\uAC00 \uACE7 \uB2E4\uC2DC
      \uB3CC\uC544\uC628\uB2E4\uB294 \uB73B\uC77C\uC9C0\uB3C4 \uBAA8\uB978\uB2E4.\n\n\uC2EC\uC7A5\uC774
      \uBE60\uB974\uAC8C \uB6F0\uAE30 \uC2DC\uC791\uD588\uB2E4.\n\n\uC5EC\uAE30\uC11C
      \uAC00\uB9CC\uD788 \uC788\uB2E4\uAC00\uB294 \uBB34\uC2A8 \uC77C\uC774 \uBC8C\uC5B4\uC9C8\uC9C0
      \uC7A5\uB2F4\uD560 \uC218 \uC5C6\uB2E4.\n\n\uB354 \uC774\uC0C1 \uC774 \uACF3\uC5D0\uC11C
      \uC2DC\uAC04\uC744 \uC9C0\uCCB4\uD560 \uC218 \uC5C6\uB2E4.\n\uB2F9\uC7A5 \uBE60\uC838\uB098\uAC08
      \uBC29\uBC95\uC744 \uCC3E\uC544\uC57C \uD55C\uB2E4.\n\n\uADF8\uB4E4\uC774 \uB2E4\uC2DC
      \uB3CC\uC544\uC624\uAE30 \uC804 \uAE4C\uC9C0"
  charsPerSecond: 25
  pauseBetweenEntries: 0.5
  useUnscaledTime: 0
  typeSource: {fileID: 602790557}
  useLoopSound: 1
